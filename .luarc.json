{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace.library": [
    "${env:PZ_UMBRELLA}",
    "${env:PZ_SOURCE}",
    "IconsInventory/mod/42/media/lua",
    "IconsInventory_ItemRarityUI/mod/42/media/lua",
    "IconsInventory_KnownAndCollected/mod/42/media/lua",
    "IconsInventory_P4HasBeenRead/mod/42/media/lua",
    "IconsInventory_SeedSeasonIndicator/mod/42/media/lua",
    "SideBySideContainers/mod/42/media/lua",
    "StaticBags/mod/42/media/lua"
  ],
  "workspace.ignoreDir": ["vanilla"],
  "runtime.path": [
    "shared/?.lua",
    "client/?.lua",
    "server/?.lua"
  ],
  "runtime.version": "Lua 5.1",
  "hint.enable": false,
  "diagnostics.globals": ["ItemRarityUI", "KnownAndCollected"],
  "diagnostics.disable": ["unnecessary-if"]
}
